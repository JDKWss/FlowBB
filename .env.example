# Neo4j Aura: replace the host and password with values from the Aura console.
# Local container: use NEO4J_URI=neo4j://neo4j:7687 with the local-db profile.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-strong-password

ASPNETCORE_ENVIRONMENT=Development
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174
