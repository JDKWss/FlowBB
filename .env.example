# Neo4j Aura: replace the host and password with values from the Aura console.
# Local container: use NEO4J_URI=neo4j://neo4j:7687 with the local-db profile.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-strong-password

ASPNETCORE_ENVIRONMENT=Development
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174

# Prywatna usluga routingu drogowego. Nie wystawiaj jej bezposrednio do przegladarki.
ROUTING_SERVICE_URL=http://routing:8000
ROUTING_TIMEOUT_SECONDS=3
ROUTING_DEMO_FALLBACK_ENABLED=true
ROUTING_MAX_SNAP_METERS=500
ROUTING_WALKING_SPEED_KMH=4.8
ROUTING_BIKE_SPEED_KMH=15

# Seq (opcjonalny podglad logow, tylko dla developerow). Wartosci ponizej sa domyslne; odkomentuj, aby je zmienic.
# Adres Seq, do ktorego loguje API uruchomione w Compose (domyslnie usluga "seq" z tego samego pliku):
# SEQ_SERVER_URL=http://seq:5341
# Domyslnie Seq startuje bez logowania (UI dostepne tylko z tego komputera, http://localhost:5341).
# Na wspolnej maszynie ustaw false i po pierwszym uruchomieniu skonfiguruj haslo w UI Seq. Nie zapisuj hasel w repozytorium.
# SEQ_FIRSTRUN_NOAUTHENTICATION=true
# Port UI Seq na tym komputerze. Zmien, jesli 5341 jest juz zajety (np. przez lokalnie zainstalowany Seq).
# Uwaga: API uruchomione poza Compose (dotnet run) wysyla logi na http://localhost:5341 z appsettings.json.
# SEQ_HOST_PORT=5341
